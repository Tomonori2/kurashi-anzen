{
  "name": "くらしの安全相談AI",
  "short_name": "くらしの安全",
  "description": "詐欺電話の警告・暮らしの安全相談・通話録音の詐欺判定を1つにまとめたアプリ",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#143a66",
  "theme_color": "#143a66",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "いま電話が来ている", "short_name": "通話中", "url": "./#call" },
    { "name": "相談する", "short_name": "相談", "url": "./#soudan" }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["audio/*", "video/mp4", "video/webm"] }
      ]
    }
  }
}
